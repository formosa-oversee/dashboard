{
  "name": "formosa-oversee",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "npm run fetch-data && next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "deploy": "npm run build && touch out/.nojekyll && git add out/ && git commit -m \"Deploy to gh-pages\" && git subtree push --prefix out origin gh-pages",
    "download-epa": "CLOUDSDK_ACTIVE_CONFIG_NAME=formosa node scripts/download-epa-data.js",
    "fetch-data": "node scripts/fetch-gcs-data.js",
    "setup-epa": "npm run download-epa && npm run fetch-data",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gcloud:login": "CLOUDSDK_ACTIVE_CONFIG_NAME=formosa gcloud auth login",
    "gcloud:check": "CLOUDSDK_ACTIVE_CONFIG_NAME=formosa gcloud storage ls gs://epa_echo_data/",
    "mapping:seed": "python3 scripts/seed-company-mapping.py",
    "ownership": "python3 scripts/resolve-ownership.py",
    "enforcement": "node scripts/build-enforcement.js",
    "attribution": "npm run ownership && npm run enforcement && npm run fetch-data"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Formosa Oversee - Platform for monitoring company environmental performance and violations",
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.3",
    "@emotion/styled": "^11.11.0",
    "axios": "^1.6.7",
    "chart.js": "^4.4.1",
    "framer-motion": "^11.0.5",
    "leaflet": "^1.9.4",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.0.1",
    "react-leaflet": "^4.2.1"
  }
}
